# =====================================================================
# PitchMic — environment template
#
# USAGE
#   Local host dev:  copy this to backend/.env and fill in your values
#   Docker Compose:  copy this to .env (root) — Docker injects these as env vars
#   Production:      set these as real env vars on your host / secrets manager
#
# NEVER commit real credentials.
# =====================================================================

# ------- Reverse Proxy -------
CADDY_SITE_ADDRESS=:80
NEXTJS_ORIGIN=http://frontend:3000
DJANGO_ORIGIN=http://backend:8000

# ------- Docker build targets (development | production) -------
FRONTEND_TARGET=development
BACKEND_TARGET=development
NODE_ENV=development

# ------- Postgres -------
POSTGRES_DB=pitchmic
POSTGRES_USER=pitchmic
POSTGRES_PASSWORD=CHANGE_ME_IN_PRODUCTION
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgres://pitchmic:CHANGE_ME_IN_PRODUCTION@postgres:5432/pitchmic

# ------- Redis -------
# Three separate DBs: cache/channels | Celery broker | Celery results
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ------- Django core -------
# Generate a real key with: python -c "import secrets; print(secrets.token_hex(64))"
SECRET_KEY=CHANGE_ME_USE_python_-c_import_secrets_print_secrets.token_hex_64
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,backend,pitchmic.local
DJANGO_SETTINGS_MODULE=config.settings
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://frontend:3000

# ------- Email -------
FRONTEND_BASE_URL=http://localhost:3000
DEFAULT_FROM_EMAIL=noreply@pitchmic.com
# SMTP (leave blank to use Django's console backend in dev)
# EMAIL_HOST=smtp.sendgrid.net
# EMAIL_PORT=587
# EMAIL_HOST_USER=apikey
# EMAIL_HOST_PASSWORD=CHANGE_ME
# EMAIL_USE_TLS=True

# ------- Next.js -------
# Routed through Caddy — do NOT point directly at Django (port 8000)
NEXT_PUBLIC_API_BASE_URL=http://localhost/api/v1
NEXT_PUBLIC_BFF_BASE_URL=http://localhost:3000
NEXT_PUBLIC_APP_ENV=development
NEXT_TELEMETRY_DISABLED=1

# ------- AI / LLM APIs (optional — agents gracefully fall back without these) -------
# OpenAI (used by intelligence pipeline for LLM agent calls)
OPENAI_API_KEY=sk-CHANGE_ME

# Google Gemini (alternative LLM backend for due-diligence agents)
GOOGLE_GEMINI_API_KEY=CHANGE_ME

# Perplexity Search (market strategist agent uses this for live web search)
PERPLEXITY_API_KEY=pplx-CHANGE_ME

# ------- ML Service -------
# Internal Docker service URL — do not expose publicly
ML_SERVICE_URL=http://ml-service:5000
# Optional API key for ML service (leave blank to disable auth)
ML_API_KEY=CHANGE_ME_OR_LEAVE_BLANK

# ------- ChromaDB (vector store for digital brain / RAG) -------
CHROMA_AUTH_TOKEN=pitchmic-chroma-secret
CHROMA_URL=http://chromadb:8000

# ------- Sentry (optional error tracking) -------
# SENTRY_DSN=https://CHANGE_ME@sentry.io/CHANGE_ME

# ------- AWS S3 (optional — file uploads default to local storage) -------
# AWS_ACCESS_KEY_ID=CHANGE_ME
# AWS_SECRET_ACCESS_KEY=CHANGE_ME
# AWS_STORAGE_BUCKET_NAME=pitchmic-media
# AWS_S3_REGION_NAME=us-east-1
